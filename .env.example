# ==============================================================================
# Nanogrid Telemetry Frontend Environment Configuration Example
# Copy this file to `.env` for local frontend development:
#   cp .env.example .env
#
# ==============================================================================
# CRITICAL SECURITY NOTE:
# NEVER place `DEVICE_KEY` or any private ingestion tokens in this file or any
# client-side bundle. All `VITE_*` variables are bundled into public client JS.
#
# `DEVICE_KEY` must ONLY be configured in:
#   1. Supabase Edge Function Secrets (via CLI or dashboard):
#        supabase secrets set DEVICE_KEY="your-high-entropy-secret-key-here"
#   2. Untracked ESP32 firmware header file:
#        esp32/telemetry.h (configured from esp32/telemetry.h.example)
#   3. Local mock backend environment:
#        DEVICE_KEY="your-high-entropy-secret-key-here" node scripts/mock-backend.mjs
# ==============================================================================

# Supabase Project URL (found in Supabase Project Settings -> API)
# Example: https://xyzcompanyproject.supabase.co or http://127.0.0.1:54321
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Public API Key (safe for browser client read-only queries)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Optional: Ingestion Read Endpoint
# Can point to Supabase Edge Function:
#   https://your-project-id.supabase.co/functions/v1/ingest
# Or local mock backend server during development:
#   http://localhost:8787/ingest
VITE_INGEST_READ_URL=https://your-project-id.supabase.co/functions/v1/ingest

# Optional: Viewer passcode for dashboard access gate
VITE_VIEW_PASSCODE=nanogrid2026
